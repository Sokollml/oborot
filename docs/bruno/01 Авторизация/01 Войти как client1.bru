meta {
  name: Войти как client1
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "client1@demo.local",
    "password": "{{password}}"
  }
}

docs {
  Cookie со входом сохраняется в Bruno автоматически — следующие запросы идут от этого пользователя.
}
