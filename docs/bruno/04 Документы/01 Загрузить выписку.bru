meta {
  name: Загрузить выписку
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/applications/{{appId}}/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  document_request_id: {{docId}}
  file: @file(files/statement.pdf)
}

docs {
  Работает, когда заявка в статусе INFO_REQUESTED (например, Вектор-Тест 0010000024). docId заполняется запросом «Статус заявки».
}
