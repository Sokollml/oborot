# Скопируйте в .env и при необходимости поменяйте: cp .env.example .env
# Без .env проект тоже запустится — в docker-compose.yml есть такие же значения по умолчанию.

# --- Порты на этом компьютере (поменяйте, если какой-то занят) ---
# Кабинет — точка входа
APP_PORT=3000
# API и Swagger (/docs), открыт только для этого компьютера
API_PORT=8000
# Мок внешних сервисов
MOCK_PORT=8001
# PostgreSQL для автотестов
DB_PORT=5433

# --- База данных ---
POSTGRES_USER=oborot
POSTGRES_PASSWORD=oborot
POSTGRES_DB=oborot

# --- Авторизация ---
# Секрет для подписи JWT. Для демо подойдёт любой, в реальной среде — длинный случайный.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# true — на экране входа показывается подсказка с тестовыми аккаунтами.
DEMO_MODE=true

# --- Воркер ---
# Пауза между этапами конвейера, секунды (чтобы на демо было видно, как движется статус).
STAGE_DELAY_SECONDS=2
# Как часто воркер проверяет очередь задач, секунды.
WORKER_POLL_SECONDS=1
# Если воркер упал посреди задачи, через столько секунд её подхватит следующий запуск.
JOB_LEASE_SECONDS=30

# --- Внешние сервисы (ЕГРЮЛ, ФНС, БКИ — наш мок) ---
# Таймаут одного запроса, число попыток и пауза между попытками.
EXTERNAL_TIMEOUT_SECONDS=3
EXTERNAL_RETRIES=3
EXTERNAL_RETRY_PAUSE_SECONDS=1
# Искусственная задержка ответа мок-сервиса, секунды.
MOCK_DELAY_SECONDS=0.3

# --- Тестовые аккаунты (создаются при первом запуске) ---
# client1@demo.local / client2@demo.local / analyst@demo.local
DEMO_PASSWORD=demo12345
